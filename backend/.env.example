# Copy file này thành `.env` rồi điền key (không commit `.env` lên git):
#   cp .env.example .env
#
# Giá public (WebSocket / ticker) chạy được KHÔNG cần key.
# Key chỉ cần khi gọi API có xác thực (giao dịch thật, số dư, lệnh, v.v.).

# API Key & Secret từ Binance → API Management
# https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Mainnet (mặc định) — bỏ comment nếu muốn đổi
# BINANCE_API_BASE=https://api.binance.com
# BINANCE_WS_BASE=wss://stream.binance.com:9443

# Testnet — chỉ bật khi dùng tài khoản test
# BINANCE_API_BASE=https://testnet.binance.vision
# BINANCE_WS_BASE=wss://testnet.binance.vision

# Auto-trading risk limits (paper wallet)
# AUTO_TRADE_MAX_DEPLOY_PCT=0.80
# AUTO_TRADE_MAX_POSITION_PCT=0.20
# AUTO_TRADE_STOP_LOSS_PCT=5.0
# AUTO_TRADE_STOP_LOSS_USD=0
# AUTO_TRADE_MAX_DRAWDOWN_PCT=15.0
# AUTO_TRADE_MIN_PROFIT_USD=0.25
# AUTO_TRADE_MIN_BUY_SCORE=70
# AUTO_TRADE_KILL_CONSECUTIVE_LOSSES=5
# AUTO_TRADE_KILL_DAILY_LOSS_PCT=3.0
# AUTO_TRADE_MAX_DRAWDOWN_PCT=10.0
